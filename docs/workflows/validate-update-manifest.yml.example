name: 校验更新清单

on:
  push:
    branches:
      - main
    paths:
      - "update/**"
      - "scripts/validate_manifest.py"
      - ".github/workflows/validate-update-manifest.yml"
  pull_request:
    paths:
      - "update/**"
      - "scripts/validate_manifest.py"
      - ".github/workflows/validate-update-manifest.yml"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - name: 检出仓库
        uses: actions/checkout@v4

      - name: 校验稳定版清单
        run: python3 scripts/validate_manifest.py
